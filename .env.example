APP_NAME="Laravel API Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# API Starter Package Configuration
API_STARTER_ENABLED=true
API_STARTER_PREFIX=api
API_STARTER_VERSIONING_ENABLED=true
API_STARTER_VERSIONING_DEFAULT=v1
API_STARTER_AUTH_ENABLED=true
API_STARTER_RATE_LIMIT_ENABLED=true
API_STARTER_RATE_LIMIT_REQUESTS=60
API_STARTER_RATE_LIMIT_MINUTES=1
API_STARTER_LOG_REQUESTS=false
API_STARTER_LOG_ACTIVITY=false
API_STARTER_HEALTH_ENABLED=true
API_STARTER_HEALTH_DATABASE=true
API_STARTER_HEALTH_CACHE=true

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_api_starter
DB_USERNAME=root
DB_PASSWORD=

# Cache & Session
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

{
    "name": "surya/laravel-api-starter",
    "description": "A production-ready, reusable Laravel API Starter Kit package",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Surya",
            "email": "surya@example.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/validation": "^12.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Surya\\ApiStarter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Surya\\ApiStarter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Surya\\ApiStarter\\Providers\\ApiStarterServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

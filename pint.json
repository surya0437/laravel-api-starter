{
    "preset": "laravel",
    "rules": {
        "simplified_null_return": true,
        "braces_position": {
            "functions_opening_brace": "next_line_unless_newline_at_signature_end"
        },
        "new_with_parentheses": {
            "named_class": true,
            "anonymous_class": false
        }
    }
}
